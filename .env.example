# Copy to .env (gitignored). `export KEY=value` lines are accepted too.

# Required: key for your model provider.
HARNESS_API_KEY=

# Required: provider model id, e.g. gpt-4o-mini or anthropic/claude-sonnet-4
HARNESS_MODEL=

# Base URL of an OpenAI-compatible API. Defaults to OpenAI, so set this for
# OpenRouter, Groq, Together, Ollama, llama.cpp, LM Studio, etc.
# HARNESS_BASE_URL=https://api.openai.com/v1
# HARNESS_BASE_URL=https://openrouter.ai/api/v1
# HARNESS_BASE_URL=http://localhost:11434/v1

# Optional: adventofcode.com session cookie, enables Part Two and your inputs
# during `harness scrape`.
# AOC_SESSION=

# Optional: log filter, e.g. debug or harness=debug,aoc_archive=info
# HARNESS_LOG=info
